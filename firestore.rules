rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{uid}/projects/{projectId}
    // Document ID: projectId (string, project identifier)
    // Description: Project metadata document tracking synchronization head and schema.
    // Fields:
    //   - name: string (project display title)
    //   - headSeq: int (latest sequence number in event log)
    //   - headHash: string (SHA-256 hash of head event)
    //   - updatedAt: timestamp or string (last update timestamp)
    //   - schemaVersion: int or string (schema version identifier)
    //
    // Subcollection: /users/{uid}/projects/{projectId}/events/{seq}
    // Document ID: seq (zero-padded sequence string, e.g. "000042")
    // Description: Append-only immutable event log entry.
    // Fields:
    //   - seq: int (monotonic sequence number, required)
    //   - hash: string (SHA-256 event hash, required)
    //   - prevHash: string (SHA-256 previous event hash, required)
    //   - event: map (full CWS event payload including envelope, required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the user path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate required fields and types for event documents
    function isValidEvent(data) {
      return data.seq is int
        && data.hash is string
        && data.prevHash is string
        && data.event is map;
    }

    // ===============================================================
    // Security Rules
    // ===============================================================

    // Project metadata document: /users/{uid}/projects/{projectId}
    // Only the authenticated project owner has read and write access.
    // Cross-user access is strictly forbidden.
    match /users/{uid}/projects/{projectId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      // Event history subcollection: /users/{uid}/projects/{projectId}/events/{seq}
      // Strictly append-only ledger:
      // - Only the project owner can read and append events.
      // - Overwriting an existing event document is prevented.
      // - Required schema types are enforced (seq: int, hash: str, prevHash: str, event: map).
      // - Updates and deletions are permanently disallowed to guarantee immutability.
      match /events/{seq} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && !exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId)/events/$(seq))
          && isValidEvent(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
