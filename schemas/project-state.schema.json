{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cognitive-work-system/schemas/project-state.json",
  "title": "ProjectState",
  "description": "Formal state representation S_t = (K, U, A, D, C, P) for the Cognitive Work System",
  "type": "object",
  "required": ["id", "title", "phase", "knowledge", "unknowns", "assumptions", "decisions", "constraints", "progress", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "phase": {
      "type": "string",
      "enum": [
        "EXPLORATION",
        "UNDERSTANDING",
        "SYNTHESIS",
        "PROOF",
        "CONCEPT",
        "PLANNING",
        "IMPLEMENTATION",
        "LAUNCH",
        "POST_LAUNCH"
      ]
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "epistemicType", "source", "recordedAt"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "epistemicType": { "type": "string", "enum": ["FACT", "SYNTHESIS", "OBSERVATION"] },
          "source": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "status", "priority", "recordedAt"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "context": { "type": "string" },
          "status": { "type": "string", "enum": ["OPEN", "INVESTIGATING", "ANSWERED", "DEFERRED"] },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "riskLevel", "status", "recordedAt"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "FATAL"] },
          "status": { "type": "string", "enum": ["UNTESTED", "VALIDATING", "VALIDATED", "FALSIFIED"] },
          "validationMethod": { "type": "string" },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "selectedOption", "rationale", "decidedBy", "recordedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "context": { "type": "string" },
          "optionsConsidered": { "type": "array", "items": { "type": "string" } },
          "selectedOption": { "type": "string" },
          "rationale": { "type": "string" },
          "consequences": { "type": "array", "items": { "type": "string" } },
          "decidedBy": { "type": "string", "enum": ["HUMAN", "SYSTEM_DEFAULT"] },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["TECHNICAL", "BUDGET", "TIME", "REGULATORY", "SCOPE"] },
          "description": { "type": "string" }
        }
      }
    },
    "progress": {
      "type": "object",
      "required": ["currentObjective", "completedMilestones", "activeWorkstream"],
      "properties": {
        "currentObjective": { "type": "string" },
        "activeWorkstream": { "type": "string" },
        "completedMilestones": { "type": "array", "items": { "type": "string" } },
        "healthSignal": { "type": "string", "enum": ["GREEN", "YELLOW", "BLOCKED"] }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
