{
  "name": "cws",
  "version": "2.0.0-alpha.0",
  "description": "Cognitive Work System v2: human-led, event-sourced project memory with agent-agnostic prompts.",
  "type": "module",
  "bin": { "cws": "dist/cli/main.js" },
  "files": ["dist", "prompts"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "coverage": "c8 --reporter=text --check-coverage --lines 80 --functions 80 --branches 75 npm test",
    "cws": "node --import tsx src/cli/main.ts"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
